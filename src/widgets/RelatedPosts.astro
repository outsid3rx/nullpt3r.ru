---
import type { CollectionEntry } from 'astro:content';
import { postSlug } from '../shared/lib/db';

export interface Props {
  currentSlug: string;
  posts: CollectionEntry<'posts'>[];
}

const { currentSlug, posts } = Astro.props;
const currentPost = posts.find((p) => postSlug(p) === currentSlug);
const currentTags = currentPost?.data.tags ?? [];

const related = posts
  .filter((p) => postSlug(p) !== currentSlug)
  .sort((a, b) => {
    const aMatch = a.data.tags.some((t) => currentTags.includes(t));
    const bMatch = b.data.tags.some((t) => currentTags.includes(t));
    if (aMatch && !bMatch) return -1;
    if (!aMatch && bMatch) return 1;
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  })
  .slice(0, 3);
---

{
  related.length > 0 && (
    <section class="mx-auto mt-10 max-w-[720px] border-t border-border px-6 pt-10" data-od-id="related">
      <h2 class="m-0 mb-6 font-display text-[20px]/[1.3] font-semibold -tracking-[0.015em]">Читайте также</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {related.map((post) => {
          const dateStr = post.data.publishedAt.toLocaleDateString('ru-RU', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          });
          const slug = postSlug(post);
          return (
            <a href={`/posts/${slug}`} class="block text-inherit no-underline transition-opacity duration-150 hover:opacity-70">
              <div class="mb-3 aspect-video w-full overflow-hidden rounded-md bg-gradient-to-br from-border to-surface">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt="" loading="lazy" class="h-full w-full object-cover" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-6 w-6 text-muted opacity-40"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <circle cx="8.5" cy="8.5" r="1.5" />
                      <polyline points="21 15 16 10 5 21" />
                    </svg>
                  </div>
                )}
              </div>
              <h3 class="m-0 mb-1.5 font-display text-[14px]/[1.4] font-medium -tracking-[0.01em] text-fg">{post.data.title}</h3>
              <p class="m-0 mb-1.5 line-clamp-2 text-[12px]/[1.45] text-muted">{post.data.description}</p>
              <span class="text-[11px] text-muted">{dateStr}</span>
            </a>
          );
        })}
      </div>
    </section>
  )
}
