---
const { showProgress } = Astro.props;
---

<header
  class="sticky top-0 z-10 border-b border-border bg-[var(--bg)] backdrop-blur-lg transition-colors duration-200"
>
  <div class="mx-auto flex h-[60px] max-w-[720px] items-center justify-between px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-display text-[22px]/none font-bold -tracking-[0.03em] text-fg no-underline transition-colors duration-200 hover:text-accent"
    >
      nullptr<span class="text-accent">;</span>
      <span class="text-[13px] font-normal -tracking-[0.01em] text-muted">блог о разработке</span>
    </a>
    <button
      class="theme-toggle flex cursor-pointer items-center gap-1.5 rounded-lg border border-border bg-transparent px-3 py-1.5 font-body text-[13px]/none -tracking-[0.01em] text-muted transition-all duration-150 hover:border-accent hover:text-fg"
      id="themeToggle"
      aria-label="Переключить тему"
      data-astro-transition-persist="theme-toggle"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="block h-3.5 w-3.5"
        id="themeIcon"
      >
        <path
          id="sunIcon"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"
        ></path>
        <path id="moonIcon" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" style="display:none"
        ></path>
      </svg>
      <span id="themeLabel"></span>
    </button>
  </div>
  {
    showProgress && (
      <div class="absolute bottom-0 left-0 right-0 h-[3px] bg-border">
        <div
          class="h-full w-0 bg-accent transition-[width] duration-100 linear"
          id="progressFill"
        />
      </div>
    )
  }
</header>

<script>
  const KEY = 'nullptr-theme';
  const toggle = document.getElementById('themeToggle');
  const label = document.getElementById('themeLabel');
  const sun = document.getElementById('sunIcon');
  const moon = document.getElementById('moonIcon');

  function syncUI(dark) {
    if (label) label.textContent = dark ? 'Светлая' : 'Тёмная';
    if (sun) sun.style.display = dark ? 'none' : 'block';
    if (moon) moon.style.display = dark ? 'block' : 'none';
  }

  function setTheme(dark) {
    document.documentElement.classList.toggle('dark', dark);
    syncUI(dark);
    localStorage.setItem(KEY, dark ? 'dark' : 'light');
  }

  syncUI(document.documentElement.classList.contains('dark'));

  if (toggle && !toggle.dataset.listenerAttached) {
    toggle.dataset.listenerAttached = 'true';
    toggle.addEventListener('click', () => {
      setTheme(!document.documentElement.classList.contains('dark'));
    });
  }
</script>
